# Quadlet unit: serve the board OTA images over HTTP on the NAS.
#
# Install (rootless, user lunarian on luna):
#   mkdir -p ~/ota-images ~/.config/containers/systemd
#   cp ota-images.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ota-images.service
#
# Layout of ~/ota-images (written by scripts/04-ota-publish.sh):
#   alpine-solovox-z8pro-<ver>.img.gz          the transfer artifact
#   alpine-solovox-z8pro-<ver>.img.sha256      sha256 of the raw image
#   alpine-solovox-z8pro-<ver>.img.size        size of the raw image in bytes
#
# Clients fetch http://luna:8080/<name>.img.gz and ota-flash derives the two
# sidecar URLs from it.

[Unit]
Description=Serve board OTA images over HTTP (read-only static files)
Documentation=https://github.com/lulkien/alpine-solovox-z8pro

[Container]
ContainerName=ota-images
Image=docker.io/library/python:3.13-alpine
Exec=python3 -m http.server 8080 --directory /srv/ota --bind 0.0.0.0

# The published images live in the user's home; the container only ever reads.
Volume=%h/ota-images:/srv/ota:ro

# Served on the NAS LAN address (10.21.50.12); rootless needs a high port.
PublishPort=8080:8080

# Static server, nothing to write, no privileges.
ReadOnly=true
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=30

[Install]
WantedBy=default.target
